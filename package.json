{
  "name": "leasing-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"next dev -p ${PORT:-3041}\" \"tsx watch src/worker/index.ts\"",
    "build": "next build",
    "start": "next start -p ${PORT:-3041}",
    "worker": "tsx src/worker/index.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run -c vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:reset": "tsx scripts/reset-db.ts && tsx prisma/seed/index.ts",
    "pii:rotate": "tsx scripts/pii-rotate.ts",
    "pii:purge": "tsx scripts/pii-purge.ts",
    "postinstall": "prisma generate",
    "gen:relations": "tsx scripts/gen-relations.ts && prettier --write src/server/relations.generated.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.77",
    "@ai-sdk/openai": "4.0.72",
    "@date-fns/tz": "1.5.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-pdf/renderer": "4.9.0",
    "ai": "7.0.111",
    "better-auth": "1.7.5",
    "date-fns": "4.4.0",
    "file-type": "22.1.1",
    "ics": "3.12.0",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "pg-boss": "12.33.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "sonner": "2.0.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "fast-check": "4.10.2",
    "prettier": "3.9.8",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  }
}
