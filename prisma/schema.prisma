// Tenant tables all carry agencyId (= Better Auth Organization.id). Columns ending in Enc hold
// AES-256-GCM envelopes (src/server/crypto/fieldEncryption.ts); *Bidx columns hold HMAC blind
// indexes. Ids are UUIDv7 strings generated by the app before insert, because the encryption AAD
// includes the record id. Constraints Prisma can't express (exclusion constraints, partial
// uniques, append-only triggers, id immutability) live in prisma/migrations/*_constraints.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- Better Auth (generated)

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String          @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  settings    AgencySettings?
  properties  Property[]
  units       Unit[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ---------------------------------------------------------------- Agency configuration

model AgencySettings {
  id                String       @id @default(uuid(7))
  agencyId          String       @unique
  agency            Organization @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  timezone          String       @default("America/Los_Angeles")
  jurisdictionState String       @default("CA")
  jurisdictionCity  String?
  theme             Json
  contact           Json
  /// zod: AutomationConfig (src/server/domain/agent/policy.ts)
  automation        Json
  /// zod: RetentionConfig (src/server/domain/retention/purge.ts)
  retention         Json
  automationPaused  Boolean      @default(false)
  holdHours         Int          @default(72)
  activeCriteriaId  String?
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)
}

/// One row per agency per local day. Autonomous executions increment `used` with a
/// conditional UPDATE (used < cap) inside the decision transaction.
model AutomationQuota {
  agencyId String
  day      DateTime @db.Date
  used     Int      @default(0)
  cap      Int

  @@id([agencyId, day])
}

// ---------------------------------------------------------------- Listings

enum UnitStatus {
  AVAILABLE
  PENDING
  LEASED
  OFF_MARKET
}

model Property {
  id           String       @id @default(uuid(7))
  agencyId     String
  agency       Organization @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  name         String
  street       String
  city         String
  state        String       @default("CA")
  zip          String
  neighborhood String?
  amenities    String[]
  description  String
  yearBuilt    Int?
  units        Unit[]
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([agencyId, id])
  @@index([agencyId])
}

model Unit {
  id             String              @id @default(uuid(7))
  agencyId       String
  agency         Organization        @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  propertyId     String
  property       Property            @relation(fields: [agencyId, propertyId], references: [agencyId, id], onDelete: Restrict)
  slug           String
  label          String
  beds           Int
  baths          Float
  sqft           Int
  rentCents      Int
  depositCents   Int
  availableOn    DateTime            @db.Date
  status         UnitStatus          @default(AVAILABLE)
  description    String
  features       String[]
  petPolicy      String              @default("Cats and small dogs considered. Assistance animals are not pets.")
  listingAgentId String?
  photoSeed      Int                 @default(0)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  opportunities  Opportunity[]
  showings       Showing[]
  applications   Application[]
  holds          UnitHold[]
  leases         Lease[]
  residencies    Residency[]
  tickets        MaintenanceTicket[]

  @@unique([agencyId, id])
  @@unique([agencyId, slug])
  @@index([agencyId, status])
}

// ---------------------------------------------------------------- Funnel

enum OpportunityStage {
  INTEREST
  SHOWING
  APPLIED
  SCREENED
  DECISION
  LEASE_SIGNED
  LOST
}

model Lead {
  id            String        @id
  agencyId      String
  nameEnc       String
  emailEnc      String
  emailBidx     String
  phoneEnc      String?
  source        String        @default("website")
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  opportunities Opportunity[]
  showings      Showing[]
  applications  Application[]
  leases        Lease[]
  residencies   Residency[]

  @@unique([agencyId, id])
  @@unique([agencyId, emailBidx])
  @@index([agencyId])
}

model Opportunity {
  id             String                 @id @default(uuid(7))
  agencyId       String
  leadId         String
  lead           Lead                   @relation(fields: [agencyId, leadId], references: [agencyId, id], onDelete: Cascade)
  unitId         String
  unit           Unit                   @relation(fields: [agencyId, unitId], references: [agencyId, id], onDelete: Cascade)
  stage          OpportunityStage       @default(INTEREST)
  stageChangedAt DateTime               @default(now()) @db.Timestamptz(3)
  lostReason     String?
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  interests      IndicationOfInterest[]
  stageEvents    StageEvent[]

  @@unique([agencyId, id])
  @@unique([leadId, unitId])
  @@index([agencyId, stage])
}

/// Every stage change, for time-in-stage metrics.
model StageEvent {
  id            String            @id @default(uuid(7))
  agencyId      String
  opportunityId String
  opportunity   Opportunity       @relation(fields: [agencyId, opportunityId], references: [agencyId, id], onDelete: Cascade)
  from          OpportunityStage?
  to            OpportunityStage
  at            DateTime          @default(now()) @db.Timestamptz(3)

  @@index([agencyId, at])
}

model IndicationOfInterest {
  id            String      @id
  agencyId      String
  opportunityId String
  opportunity   Opportunity @relation(fields: [agencyId, opportunityId], references: [agencyId, id], onDelete: Cascade)
  desiredMoveIn DateTime    @db.Date
  messageEnc    String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@index([agencyId])
}

model AvailabilityRule {
  id          String @id @default(uuid(7))
  agencyId    String
  agentUserId String
  weekday     Int // 0 = Sunday, local to the agency timezone
  startMin    Int
  endMin      Int
  slotMin     Int    @default(30)
  bufferMin   Int    @default(15)

  @@index([agencyId, agentUserId])
}

model AvailabilityException {
  id          String   @id @default(uuid(7))
  agencyId    String
  agentUserId String
  startsAt    DateTime @db.Timestamptz(3)
  endsAt      DateTime @db.Timestamptz(3)
  reason      String?

  @@index([agencyId, agentUserId])
}

enum ShowingStatus {
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELED
}

model Showing {
  id              String        @id @default(uuid(7))
  agencyId        String
  unitId          String
  unit            Unit          @relation(fields: [agencyId, unitId], references: [agencyId, id], onDelete: Cascade)
  leadId          String
  lead            Lead          @relation(fields: [agencyId, leadId], references: [agencyId, id], onDelete: Cascade)
  agentUserId     String
  startsAt        DateTime      @db.Timestamptz(3)
  endsAt          DateTime      @db.Timestamptz(3)
  status          ShowingStatus @default(SCHEDULED)
  icsUid          String        @unique
  icsSequence     Int           @default(0)
  /// sha256 of HMAC(TOKEN_KEY, "showing|id|tokenVersion"); bump tokenVersion to reissue
  manageTokenHash String        @unique
  tokenVersion    Int           @default(1)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  /// Last change to anything that appears in the invite; used as the ics DTSTAMP
  changedAt       DateTime      @default(now()) @db.Timestamptz(3)

  @@index([agencyId, startsAt])
}

// ---------------------------------------------------------------- Applications

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  REFERENCES_PENDING
  SCREENING
  SCREENED
  DECISION_PENDING
  APPROVED
  CONDITIONAL
  DECLINED
  WITHDRAWN
  LEASE_SENT
  LEASE_SIGNED
}

enum IncomeType {
  EMPLOYMENT
  SELF_EMPLOYMENT
  BENEFITS
  OTHER
}

model Application {
  id                  String               @id
  agencyId            String
  leadId              String
  lead                Lead                 @relation(fields: [agencyId, leadId], references: [agencyId, id], onDelete: Restrict)
  unitId              String
  unit                Unit                 @relation(fields: [agencyId, unitId], references: [agencyId, id], onDelete: Restrict)
  userId              String?
  status              ApplicationStatus    @default(DRAFT)
  statusChangedAt     DateTime             @default(now()) @db.Timestamptz(3)
  currentStep         Int                  @default(1)
  legalNameEnc        String?
  phoneEnc            String?
  desiredMoveIn       DateTime?            @db.Date
  /// Occupancy limits only. Never scored and never sent to an LLM.
  totalOccupants      Int?
  incomeType          IncomeType?
  monthlyIncomeCents  Int?
  hasRentSubsidy      Boolean              @default(false)
  subsidyMonthlyCents Int?
  altEvidenceProvided Boolean              @default(false)
  /// Locked at submit. The rubric always uses this version.
  criteriaVersionId   String?
  criteria            ScreeningCriteria?   @relation(fields: [agencyId, criteriaVersionId], references: [agencyId, id], onDelete: Restrict)
  submittedAt         DateTime?            @db.Timestamptz(3)
  purgedAt            DateTime?            @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  residences          ResidenceHistory[]
  consents            ConsentRecord[]
  references          ReferenceRequest[]
  screeningRequests   ScreeningRequest[]
  steps               AgentStep[]
  recommendations     Recommendation[]
  decisions           Decision[]
  hold                UnitHold?
  lease               Lease?
  adverseAction       AdverseActionNotice?
  tasks               ApprovalTask[]
  documents           GeneratedDocument[]

  @@unique([agencyId, id])
  @@index([agencyId, status])
}

model ResidenceHistory {
  id               String             @id
  agencyId         String
  applicationId    String
  application      Application        @relation(fields: [agencyId, applicationId], references: [agencyId, id], onDelete: Cascade)
  addressEnc       String?
  landlordNameEnc  String?
  landlordEmailEnc String?
  landlordPhoneEnc String?
  startDate        DateTime           @db.Date
  endDate          DateTime?          @db.Date
  monthlyRentCents Int
  consentToContact Boolean            @default(false)
  references       ReferenceRequest[]

  @@unique([agencyId, id])
  @@index([agencyId, applicationId])
}

enum ConsentType {
  FCRA_AUTHORIZATION
  REFERENCE_CONTACT
  ESIGN
  PRIVACY
}

model ConsentRecord {
  id            String      @id @default(uuid(7))
  agencyId      String
  applicationId String
  application   Application @relation(fields: [agencyId, applicationId], references: [agencyId, id], onDelete: Restrict)
  type          ConsentType
  textVersion   String
  textSha256    String
  acceptedAt    DateTime    @default(now()) @db.Timestamptz(3)
  ip            String?
  ua            String?

  @@unique([applicationId, type])
}

enum ReferenceStatus {
  SENT
  OPENED
  COMPLETED
  EXPIRED
}

model ReferenceRequest {
  id            String             @id @default(uuid(7))
  agencyId      String
  applicationId String
  application   Application        @relation(fields: [agencyId, applicationId], references: [agencyId, id], onDelete: Cascade)
  residenceId   String
  residence     ResidenceHistory   @relation(fields: [agencyId, residenceId], references: [agencyId, id], onDelete: Cascade)
  /// sha256 of HMAC(TOKEN_KEY, "reference|id|tokenVersion")
  tokenHash     String             @unique
  tokenVersion  Int                @default(1)
  expiresAt     DateTime           @db.Timestamptz(3)
  status        ReferenceStatus    @default(SENT)
  remindersSent Int                @default(0)
  usedAt        DateTime?          @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  response      ReferenceResponse?

  @@unique([agencyId, id])
  @@unique([applicationId, residenceId])
}

model ReferenceResponse {
  id                 String           @id
  agencyId           String
  referenceRequestId String           @unique
  request            ReferenceRequest @relation(fields: [agencyId, referenceRequestId], references: [agencyId, id], onDelete: Cascade)
  paidOnTime         String // ALWAYS | MOSTLY | RARELY
  lateCount          Int
  leaseViolations    Boolean
  noticeGiven        Boolean
  propertyCondition  Int // 1-5
  wouldRentAgain     String // YES | MAYBE | NO
  freeTextEnc        String?
  respondentRole     String
  attestation        Boolean
  aiAnalysis         Json?
  redactionCount     Int              @default(0)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([agencyId, referenceRequestId])
}

// ---------------------------------------------------------------- Screening

/// Append-only (UPDATE is blocked by a trigger). A new version is a new row.
model ScreeningCriteria {
  id           String        @id @default(uuid(7))
  agencyId     String
  version      Int
  config       Json
  configSha256 String
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  applications Application[]

  @@unique([agencyId, id])
  @@unique([agencyId, version])
}

enum ScreeningStatus {
  PENDING_INVITE
  INVITED
  CONSENTED
  IN_PROGRESS
  COMPLETE
  ERROR
}

/// Inserted before the provider call, keyed by the idempotency key we send to the provider.
model ScreeningRequest {
  id                   String           @id @default(uuid(7))
  agencyId             String
  applicationId        String
  application          Application      @relation(fields: [agencyId, applicationId], references: [agencyId, id], onDelete: Cascade)
  criteriaVersionId    String
  provider             String
  idempotencyKey       String           @unique
  providerApplicantRef String?          @unique
  providerReportId     String?
  hostedUrl            String?
  status               ScreeningStatus  @default(PENDING_INVITE)
  createdAt            DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(3)
  result               ScreeningResult?

  @@unique([agencyId, id])
  @@unique([applicationId, criteriaVersionId])
}

model WebhookEvent {
  id         String   @id @default(uuid(7))
  provider   String
  eventId    String
  receivedAt DateTime @default(now()) @db.Timestamptz(3)
  payload    Json

  @@unique([provider, eventId])
}

/// Derived fields only. There is deliberately no criminal-history column.
model ScreeningResult {
  id                          String           @id
  agencyId                    String
  screeningRequestId          String           @unique
  request                     ScreeningRequest @relation(fields: [agencyId, screeningRequestId], references: [agencyId, id], onDelete: Cascade)
  creditBand                  String // EXCELLENT | GOOD | FAIR | POOR | THIN_FILE
  /// Kept only for the adverse-action score disclosure; purged on the credit retention window.
  creditScoreEnc              String?
  scoreModel                  String?
  scoreRangeMin               Int?
  scoreRangeMax               Int?
  keyFactors                  String[]
  scoreDate                   DateTime?        @db.Date
  evictionJudgmentsInLookback Int
  collectionsNonMedicalCount  Int
  collectionsNonMedicalCents  Int
  identityVerified            Boolean
  incomeVerified              Boolean
  craDisclosure               Json
  receivedAt                  DateTime         @default(now()) @db.Timestamptz(3)
  purgedAt                    DateTime?        @db.Timestamptz(3)

  @@unique([agencyId, screeningRequestId])
}

// ---------------------------------------------------------------- Agent

enum StepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  /// retryable
  FAILED
  /// attempt cap or input drift; needs a person
  DEAD
}

/// Durable step record. pg-boss is at-least-once, so the queue only schedules work; this row
/// decides whether a step still needs doing. A retry of a SUCCEEDED step returns outputJson.
model AgentStep {
  id                String      @id @default(uuid(7))
  agencyId          String
  applicationId     String
  application       Application @relation(fields: [agencyId, applicationId], references: [agencyId, id], onDelete: Cascade)
  criteriaVersionId String
  stepName          String
  status            StepStatus  @default(PENDING)
  attempt           Int         @default(0)
  /// fresh random token per claim, not a worker id
  leaseOwner        String?
  leaseUntil        DateTime?   @db.Timestamptz(3)
  inputJson         Json?
  inputSha256       String?
  outputJson        Json?
  outputSha256      String?
  /// Safe to show in the timeline: counts, scores, versions. Never PII.
  outputSummary     Json?
  error             String?
  startedAt         DateTime?   @db.Timestamptz(3)
  finishedAt        DateTime?   @db.Timestamptz(3)
  durationMs        Int?
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([applicationId, criteriaVersionId, stepName])
  @@index([agencyId])
}

model LlmCall {
  id               String   @id
  agencyId         String
  applicationId    String?
  purpose          String
  promptVersion    String
  provider         String
  model            String
  inputHash        String
  redactedInputEnc String?
  output           Json
  latencyMs        Int
  tokensIn         Int?
  tokensOut        Int?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@index([agencyId, inputHash])
}

enum Outcome {
  APPROVE
  CONDITIONAL
  DECLINE
  NEEDS_REVIEW
}

model Recommendation {
  id                String      @id @default(uuid(7))
  agencyId          String
  applicationId     String
  application       Application @relation(fields: [agencyId, applicationId], references: [agencyId, id], onDelete: Cascade)
  criteriaVersionId String
  rubricScore       Int
  breakdown         Json
  flags             String[]
  outcome           Outcome
  conditions        String[]
  rationale         String
  rationaleSource   String // LLM | TEMPLATE
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([applicationId, criteriaVersionId])
}

enum DecisionMode {
  MANUAL
  ASSISTED
  AUTONOMOUS
}

model Decision {
  id                     String       @id @default(uuid(7))
  agencyId               String
  applicationId          String
  application            Application  @relation(fields: [agencyId, applicationId], references: [agencyId, id], onDelete: Restrict)
  criteriaVersionId      String
  outcome                Outcome
  mode                   DecisionMode
  decidedByType          String // USER | AGENT
  decidedById            String?
  reasonCodes            String[]
  overrodeRecommendation Boolean      @default(false)
  overrideReason         String?
  createdAt              DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([applicationId, criteriaVersionId])
  @@index([agencyId, createdAt])
}

enum TaskType {
  DECISION
  DOCUMENTS
  ADVERSE_ACTION
  ESCALATION
}

enum TaskStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model ApprovalTask {
  id                String       @id @default(uuid(7))
  agencyId          String
  applicationId     String?
  application       Application? @relation(fields: [agencyId, applicationId], references: [agencyId, id], onDelete: Restrict)
  ticketId          String?
  type              TaskType
  idempotencyKey    String       @unique
  payload           Json
  escalationReasons String[]
  status            TaskStatus   @default(OPEN)
  dueAt             DateTime?    @db.Timestamptz(3)
  resolvedById      String?
  resolvedAt        DateTime?    @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)

  @@index([agencyId, status])
}

model AdverseActionNotice {
  id            String      @id @default(uuid(7))
  agencyId      String
  applicationId String      @unique
  application   Application @relation(fields: [agencyId, applicationId], references: [agencyId, id], onDelete: Restrict)
  reasonCodes   Json
  basis         String[]
  craSnapshot   Json
  documentId    String?
  sentAt        DateTime?   @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([agencyId, applicationId])
}

// ---------------------------------------------------------------- Outbox and documents

enum OutboxKind {
  EMAIL
  DOCUMENT
}

enum OutboxStatus {
  PENDING
  SENDING
  DONE
  NEEDS_REVIEW
  FAILED
}

/// Written in the same transaction as the state change that caused it. The payload holds
/// references (ids, template names), never addresses or other PII; the dispatcher resolves the
/// recipient at send time.
model OutboxMessage {
  id                String       @id @default(uuid(7))
  agencyId          String
  kind              OutboxKind
  idempotencyKey    String       @unique
  payload           Json
  status            OutboxStatus @default(PENDING)
  attempts          Int          @default(0)
  availableAt       DateTime     @default(now()) @db.Timestamptz(3)
  leaseUntil        DateTime?    @db.Timestamptz(3)
  firstAttemptAt    DateTime?    @db.Timestamptz(3)
  lastAttemptAt     DateTime?    @db.Timestamptz(3)
  transport         String?
  /// sha256 of what the first attempt rendered; a later attempt that renders differently is flagged
  renderedSha256    String?
  providerMessageId String?
  error             String?
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  doneAt            DateTime?    @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([agencyId, createdAt])
}

enum DocumentKind {
  LEASE
  SIGNED_LEASE
  SUMMARY
  ADVERSE_ACTION
}

model GeneratedDocument {
  id              String       @id @default(uuid(7))
  agencyId        String
  applicationId   String?
  application     Application? @relation(fields: [agencyId, applicationId], references: [agencyId, id], onDelete: Restrict)
  leaseId         String?
  kind            DocumentKind
  templateVersion String
  idempotencyKey  String       @unique
  storageKey      String
  sha256          String
  bytes           Int
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)

  @@index([agencyId, applicationId])
}

// ---------------------------------------------------------------- Holds, leases, residencies

enum HoldStatus {
  ACTIVE
  WAITLISTED
  CONSUMED
  EXPIRED
  RELEASED
}

/// At most one ACTIVE hold per unit at any instant (exclusion constraint on the time range).
model UnitHold {
  id            String      @id @default(uuid(7))
  agencyId      String
  unitId        String
  unit          Unit        @relation(fields: [agencyId, unitId], references: [agencyId, id], onDelete: Restrict)
  applicationId String      @unique
  application   Application @relation(fields: [agencyId, applicationId], references: [agencyId, id], onDelete: Restrict)
  status        HoldStatus
  startsAt      DateTime?   @db.Timestamptz(3)
  expiresAt     DateTime?   @db.Timestamptz(3)
  queuedAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  @@unique([agencyId, applicationId])
  @@index([unitId, status])
}

enum LeaseStatus {
  DRAFT
  SENT
  SIGNED
  VOID
}

model Lease {
  id                 String      @id @default(uuid(7))
  agencyId           String
  applicationId      String      @unique
  application        Application @relation(fields: [agencyId, applicationId], references: [agencyId, id], onDelete: Restrict)
  unitId             String
  unit               Unit        @relation(fields: [agencyId, unitId], references: [agencyId, id], onDelete: Restrict)
  /// the applicant's Lead id
  signerId           String
  signer             Lead        @relation(fields: [agencyId, signerId], references: [agencyId, id], onDelete: Restrict)
  rentCents          Int
  depositCents       Int
  startDate          DateTime    @db.Date
  endDate            DateTime    @db.Date
  status             LeaseStatus @default(DRAFT)
  /// sha256 of HMAC(TOKEN_KEY, "lease|id|tokenVersion"). Never cleared, so a replayed signing can still authenticate.
  signTokenHash      String      @unique
  tokenVersion       Int         @default(1)
  signTokenExpiresAt DateTime    @db.Timestamptz(3)
  sentAt             DateTime?   @db.Timestamptz(3)
  signedAt           DateTime?   @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  signatures         Signature[]
  residency          Residency?

  @@unique([agencyId, id])
  @@unique([agencyId, applicationId])
}

model Signature {
  id           String   @id @default(uuid(7))
  agencyId     String
  leaseId      String
  lease        Lease    @relation(fields: [agencyId, leaseId], references: [agencyId, id], onDelete: Restrict)
  signerId     String
  typedName    String
  ip           String?
  ua           String?
  /// sha256 of the LEASE document the signer reviewed (the client echoes it back)
  docSha256    String
  signedAt     DateTime @db.Timestamptz(3)
  /// The exact success body returned the first time, replayed on retries.
  responseJson Json

  @@unique([leaseId, signerId])
}

enum ResidencyStatus {
  FUTURE
  CURRENT
  NOTICE
  PAST
}

model Residency {
  id             String              @id @default(uuid(7))
  agencyId       String
  unitId         String
  unit           Unit                @relation(fields: [agencyId, unitId], references: [agencyId, id], onDelete: Restrict)
  leaseId        String?             @unique
  lease          Lease?              @relation(fields: [agencyId, leaseId], references: [agencyId, id], onDelete: Restrict)
  leadId         String?
  lead           Lead?               @relation(fields: [agencyId, leadId], references: [agencyId, id], onDelete: Restrict)
  residentUserId String?
  moveIn         DateTime            @db.Date
  moveOut        DateTime?           @db.Date
  status         ResidencyStatus
  rentCents      Int
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  tickets        MaintenanceTicket[]

  @@unique([agencyId, id])
  @@unique([agencyId, leaseId])
  @@index([agencyId, status])
}

// ---------------------------------------------------------------- Maintenance

enum TicketCategory {
  PLUMBING
  ELECTRICAL
  HVAC
  APPLIANCE
  PEST
  STRUCTURAL
  LOCKS_SECURITY
  OTHER
}

enum Urgency {
  EMERGENCY
  HIGH
  NORMAL
  LOW
}

enum TicketStatus {
  NEW
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
  CANCELED
}

model MaintenanceTicket {
  id                           String          @id @default(uuid(7))
  agencyId                     String
  unitId                       String
  unit                         Unit            @relation(fields: [agencyId, unitId], references: [agencyId, id], onDelete: Restrict)
  residencyId                  String?
  residency                    Residency?      @relation(fields: [agencyId, residencyId], references: [agencyId, id], onDelete: Restrict)
  reporterUserId               String?
  title                        String
  description                  String
  category                     TicketCategory  @default(OTHER)
  urgency                      Urgency         @default(NORMAL)
  aiTriage                     Json?
  triageSource                 String? // RULE | LLM | OFFLINE | HUMAN
  safetyRule                   String?
  status                       TicketStatus    @default(NEW)
  assigneeUserId               String?
  permissionToEnter            Boolean         @default(false)
  slaRespondBy                 DateTime?       @db.Timestamptz(3)
  slaResolveBy                 DateTime?       @db.Timestamptz(3)
  firstRespondedAt             DateTime?       @db.Timestamptz(3)
  resolvedAt                   DateTime?       @db.Timestamptz(3)
  onHoldSince                  DateTime?       @db.Timestamptz(3)
  pausedMs                     Int             @default(0)
  respondBreached              Boolean         @default(false)
  resolveBreached              Boolean         @default(false)
  escalatedAt                  DateTime?       @db.Timestamptz(3)
  possibleAccommodationRequest Boolean         @default(false)
  createdAt                    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime        @updatedAt @db.Timestamptz(3)
  photos                       TicketPhoto[]
  comments                     TicketComment[]
  events                       TicketEvent[]

  @@unique([agencyId, id])
  @@index([agencyId, status])
}

model TicketPhoto {
  id         String            @id @default(uuid(7))
  agencyId   String
  ticketId   String
  ticket     MaintenanceTicket @relation(fields: [agencyId, ticketId], references: [agencyId, id], onDelete: Cascade)
  storageKey String
  thumbKey   String
  bytes      Int
  width      Int
  height     Int
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
}

model TicketComment {
  id           String            @id @default(uuid(7))
  agencyId     String
  ticketId     String
  ticket       MaintenanceTicket @relation(fields: [agencyId, ticketId], references: [agencyId, id], onDelete: Cascade)
  authorUserId String?
  authorType   String // STAFF | RESIDENT | SYSTEM
  body         String
  internal     Boolean           @default(false)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
}

model TicketEvent {
  id        String            @id @default(uuid(7))
  agencyId  String
  ticketId  String
  ticket    MaintenanceTicket @relation(fields: [agencyId, ticketId], references: [agencyId, id], onDelete: Cascade)
  from      TicketStatus?
  to        TicketStatus
  actorType String
  actorId   String?
  note      String?
  at        DateTime          @default(now()) @db.Timestamptz(3)
}

model SlaPolicy {
  agencyId    String
  urgency     Urgency
  respondMins Int
  resolveMins Int

  @@id([agencyId, urgency])
}

// ---------------------------------------------------------------- Platform

/// Append-only: UPDATE and DELETE raise in a trigger. metadata never contains PII.
model AuditLog {
  id        String   @id @default(uuid(7))
  agencyId  String?
  actorType String // USER | AGENT | SYSTEM | APPLICANT | REFERENCE
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([agencyId, createdAt])
}

/// Startup checks recorded by each backend process (egress canary, versions).
model ProcessCheck {
  id        String   @id @default(uuid(7))
  process   String
  check     String
  ok        Boolean
  detail    Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([process, check, createdAt])
}
