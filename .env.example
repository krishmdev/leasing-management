# Copy to .env (pnpm bootstrap does this and fills in the keys).
APP_URL=http://localhost:3041
PORT=3041
DATABASE_URL=postgresql://leasing:leasing@localhost:5441/leasing
TEST_DATABASE_URL=postgresql://leasing:leasing@localhost:5441/leasing_test
PG_PORT=5441

BETTER_AUTH_URL=http://localhost:3041
BETTER_AUTH_SECRET=

# Email. smtp -> Mailpit in dev (at-least-once). resend -> production transport with Idempotency-Key.
EMAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1041
MAILPIT_URL=http://127.0.0.1:8041
MAIL_FROM="Leasing Desk <no-reply@leasing.test>"
RESEND_API_KEY=

# Field encryption. JSON map of keyId -> base64 32-byte key.
PII_KEYRING=
PII_ACTIVE_KEY_ID=
PII_BLIND_INDEX_KEY=
# HMAC key for emailed link tokens
TOKEN_KEY=

# Screening provider (mock is the only wired provider)
SCREENING_PROVIDER=mock
MOCKCRA_WEBHOOK_SECRET=

# LLM: offline (default, deterministic, no network) | gemini | openai
LLM_PROVIDER=offline
LLM_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Dev conveniences
DEMO_MODE=true
REMINDER_OFFSETS_MIN=1440,120
# Set to 1 to run the egress canary at process start (the offline e2e does this).
EGRESS_CANARY=0
